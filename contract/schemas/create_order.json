{
  "name": "create_order",
  "description": "Create a quotation, only after the customer confirmed the items, quantities and pickup branch or delivery.",
  "requires_confirmed_intent": true,
  "parameters": {
    "type": "object",
    "properties": {
      "customer_id": {
        "type": "integer"
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "product_id": {
              "type": "integer"
            },
            "qty": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "product_id",
            "qty"
          ],
          "additionalProperties": false
        }
      },
      "fulfillment": {
        "type": "string",
        "enum": [
          "pickup",
          "delivery"
        ]
      },
      "branch_id": {
        "type": "integer",
        "description": "Required for pickup: a branch_id from list_branches."
      },
      "delivery_address": {
        "type": "string",
        "description": "Required for delivery."
      }
    },
    "required": [
      "customer_id",
      "items",
      "fulfillment"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "fulfillment": {
              "const": "pickup"
            }
          }
        },
        "then": {
          "required": [
            "branch_id"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "fulfillment": {
              "const": "delivery"
            }
          }
        },
        "then": {
          "required": [
            "delivery_address"
          ]
        }
      }
    ],
    "additionalProperties": false
  },
  "returns": {
    "type": "object",
    "description": "order_id, state, total, branch_id used.",
    "properties": {
      "order_id": {
        "type": "integer"
      },
      "state": {
        "type": "string"
      }
    }
  },
  "errors": [
    {
      "code": "scheduled_item",
      "when": "any item is a scheduled/controlled medicine — never ordered via the agent"
    },
    {
      "code": "out_of_stock",
      "when": "requested qty unavailable at the required/only branch"
    },
    {
      "code": "not_found",
      "when": "customer_id or a product_id does not exist"
    },
    {
      "code": "invalid_input",
      "when": "missing branch_id for pickup or delivery_address for delivery"
    }
  ]
}
