{
  "name": "escalate_to_human",
  "description": "Hand the conversation to a pharmacist or colleague (medical advice, restricted item, complaint, abusive, unclear).",
  "requires_confirmed_intent": false,
  "parameters": {
    "type": "object",
    "properties": {
      "reason": {
        "type": "string",
        "enum": [
          "medical_advice",
          "restricted_item",
          "low_confidence",
          "abusive",
          "unclear",
          "out_of_scope",
          "complaint",
          "prescription"
        ]
      },
      "summary": {
        "type": "string"
      },
      "customer_id": {
        "type": "integer"
      },
      "order_id": {
        "type": "integer",
        "description": "The order it is about, if any."
      }
    },
    "required": [
      "reason",
      "summary"
    ],
    "additionalProperties": false
  },
  "returns": {
    "type": "object",
    "description": "handover_id, acknowledgement text to send to the customer.",
    "properties": {
      "handover_id": {
        "type": "integer"
      }
    }
  },
  "errors": []
}
