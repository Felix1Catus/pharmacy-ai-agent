# Copy to .env and fill in. NEVER commit .env.
# --- Odoo (local docker) ---
ODOO_URL=http://localhost:8069
ODOO_DB=pharmacy
ODOO_USER=admin
ODOO_PASSWORD=admin
# --- Postgres (used by docker compose) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
# --- WhatsApp Meta Cloud API (human provides later) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# --- GPU box (human starts it) ---
GPU_SSH_HOST=
GPU_SSH_USER=
