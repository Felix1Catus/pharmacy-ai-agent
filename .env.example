# Copy to .env and fill in. NEVER commit .env.
# --- Odoo: the local docker one, or an Odoo 18 on another server (docs/odoo-connection.md) ---
# local: http://127.0.0.1:8069   remote: https://odoo.example.com (always https to another host)
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=pharmacy
# The assistant's own login. A fresh database starts as admin/admin; bootstrap then runs
# scripts/create_service_user.py --write-env, which puts the least-privilege service account
# here and moves the administrator to ODOO_ADMIN_USER / ODOO_ADMIN_PASSWORD below.
ODOO_USER=admin
ODOO_PASSWORD=admin
# an API key of that user instead of the password (preferred for a remote Odoo)
ODOO_API_KEY=
# administrator login: only set-up scripts (seed, create_service_user) and the test clean-up use it
ODOO_ADMIN_USER=
ODOO_ADMIN_PASSWORD=
# the address CUSTOMERS open (payment links). Set it when ODOO_URL is a private/internal address.
ODOO_PUBLIC_URL=
# TLS to a remote Odoo: leave verification on; point to a CA file for a private certificate authority
ODOO_VERIFY_SSL=1
ODOO_CA_BUNDLE=
ODOO_TIMEOUT=30
ODOO_RETRIES=2
# Odoo master password (database manager). bootstrap_server.sh generates it.
ODOO_MASTER_PASSWORD=
# --- Postgres (used by docker compose) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
# --- WhatsApp Meta Cloud API (human provides later) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved utility template WITHOUT variables ("You have an update about your order - reply to see
# it"). Meta only delivers free text within 24 h of the customer's last message; outside that the
# notifier sends this template once and delivers the real message when the customer answers.
WHATSAPP_TEMPLATE_NOTIFY=
WHATSAPP_TEMPLATE_LANG=ar
# --- GPU box (human starts it) ---
GPU_SSH_HOST=
GPU_SSH_USER=
AGENT_MODEL=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
# context the model server runs with (Ollama 4096; llama-server is started with -c 8192) and how
# much chat history is sent with each call, in characters (about 2-3 per token in Arabic)
AGENT_NUM_CTX=4096
AGENT_HISTORY_CHARS=3500
# optional HTTP adapter (adapter/app.py): required header X-Adapter-Token; unset = this machine only
ADAPTER_TOKEN=
LOG_LEVEL=INFO
OLLAMA_URL=http://localhost:11434
ADAPTER_URL=http://localhost:8080
# --- WhatsApp-style test page (channels/webchat) ---
WEBCHAT_USER=pharmacy
WEBCHAT_PASSWORD=
# --- Voice notes (adapter/voice.py) ---
# speech-to-text model (faster-whisper, CPU int8): small = fast, large-v3-turbo = more accurate
ASR_MODEL=small
ASR_MAX_SECONDS=120
# --- Spoken replies (adapter/tts.py) ---
# piper = fast CPU voice (default); namaa = NAMAA-Saudi-TTS service (GPU recommended); off
TTS_ENGINE=piper
TTS_PIPER_MODEL=/opt/tts/piper/ar_JO-kareem-medium.onnx
# voice character: SPEED <1 faster, EXPRESSIVE/RHYTHM higher = livelier, PITCH >1 brighter
TTS_SPEED=1.0
TTS_EXPRESSIVE=0.667
TTS_RHYTHM=0.8
TTS_PITCH=1.0
TTS_NAMAA_URL=http://127.0.0.1:8095
# WhatsApp: answer a voice note with a voice note too
WHATSAPP_VOICE_REPLIES=1

# --- regulatory (docs/compliance.md) ---
# seller identity shown in the chat menu (e-commerce law Art. 6, MOH online pharmacy rules); leave empty until real
STORE_NAME=
STORE_CR=
STORE_MOH_LICENSE=
STORE_SFDA_LICENSE=
STORE_VAT=
STORE_ADDRESS=
STORE_PHONE=
PRIVACY_URL=
PDPL_CONSENT_VERSION=2026-11-v1
LOG_RETENTION_DAYS=90
# 1 = list over-the-counter products for a symptom (adapter/needs.py). Off: a pharmacist advises on symptoms.
SYMPTOM_SUGGESTIONS=0
