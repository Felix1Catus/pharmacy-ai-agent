<odoo>
  <!-- Pharmacist: reads prescriptions (health data) and approves / rejects them. -->
  <record id="group_pharmacy_pharmacist" model="res.groups">
    <field name="name">Pharmacy: pharmacist (prescription review)</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    <field name="comment">May open customers' prescriptions and approve or reject them. Give this to licensed pharmacists only.</field>
  </record>

  <!-- The WhatsApp assistant's own login (scripts/create_service_user.py): what the gateway
       needs and nothing else - no settings, no user management, no accounting. It stores
       prescriptions but can never approve one (action_rx_approve checks the pharmacist group). -->
  <record id="group_pharmacy_assistant" model="res.groups">
    <field name="name">Pharmacy: WhatsApp assistant (service account)</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user')),
                                     (4, ref('base.group_partner_manager')),
                                     (4, ref('sales_team.group_sale_salesman_all_leads')),
                                     (4, ref('stock.group_stock_user'))]"/>
    <field name="comment">For the assistant's service user only, never for a person.</field>
  </record>
</odoo>
