<odoo>
  <!-- Product form (Inventory / Sales): a "Pharmacy" tab with the scheduled flag -->
  <record id="product_template_form_pharmacy" model="ir.ui.view">
    <field name="name">product.template.form.pharmacy</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Pharmacy" name="pharmacy">
          <group>
            <group string="Dispensing (what the assistant may do)">
              <field name="dispensing_class" widget="badge"
                     decoration-success="dispensing_class == 'otc'"
                     decoration-warning="dispensing_class == 'prescription'"
                     decoration-danger="dispensing_class == 'scheduled'"/>
              <field name="is_scheduled" string="Scheduled"/>
              <field name="schedule_class" invisible="not is_scheduled"/>
              <field name="rx_required_manual"/>
            </group>
            <group string="Storage (the assistant answers from these)">
              <field name="storage_class" widget="badge" decoration-info="cold_chain"/>
              <field name="storage_min_c" invisible="not storage_has_min"/>
              <field name="storage_max_c" invisible="not storage_has_max"/>
              <field name="storage_has_min" invisible="1"/>
              <field name="storage_has_max" invisible="1"/>
              <field name="storage_protect_light"/>
              <field name="storage_protect_moisture"/>
              <field name="storage_no_freeze"/>
              <field name="cold_chain"/>
              <field name="storage_note" placeholder="Overrides the SFDA storage text"/>
              <field name="shelf_life_months"/>
              <field name="manufacturer_country"/>
            </group>
          </group>
          <div class="text-muted" invisible="not is_scheduled">
            Scheduled products are never ordered or held by the WhatsApp agent; customers asking
            for them are referred to a pharmacist.
          </div>
          <group string="SFDA registry" invisible="not sfda_reg_no">
            <group>
              <field name="sfda_reg_no"/>
              <field name="sfda_scientific_name"/>
              <field name="sfda_strength"/>
              <field name="sfda_dosage_form"/>
              <field name="sfda_route"/>
              <field name="sfda_pack"/>
              <field name="sfda_atc_code"/>
              <field name="sfda_public_price"/>
            </group>
            <group>
              <field name="sfda_control"/>
              <field name="sfda_dispensing"/>
              <field name="sfda_requires_prescription"/>
              <field name="sfda_distribution"/>
              <field name="sfda_license_status"/>
              <field name="sfda_marketing_status"/>
              <field name="sfda_shelf_life"/>
              <field name="sfda_storage"/>
            </group>
            <group colspan="2">
              <field name="sfda_manufacturer"/>
              <field name="sfda_marketing_company"/>
              <field name="sfda_agent"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <!-- Product list: optional "Scheduled" column -->
  <record id="product_template_list_pharmacy" model="ir.ui.view">
    <field name="name">product.template.list.pharmacy</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_tree_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="is_scheduled" string="Scheduled" optional="show"/>
        <field name="dispensing_class" optional="show"/>
        <field name="storage_class" optional="hide"/>
      </xpath>
    </field>
  </record>

  <!-- Search: "Scheduled" filter -->
  <record id="product_template_search_pharmacy" model="ir.ui.view">
    <field name="name">product.template.search.pharmacy</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_search_view"/>
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='filter_to_sell']" position="before">
        <filter string="Scheduled" name="filter_scheduled" domain="[('is_scheduled', '=', True)]"/>
        <filter string="Prescription (SFDA)" name="filter_sfda_rx" domain="[('sfda_requires_prescription', '=', True)]"/>
        <filter string="Over the counter" name="filter_otc" domain="[('dispensing_class', '=', 'otc')]"/>
        <filter string="Prescription only" name="filter_rx" domain="[('dispensing_class', '=', 'prescription')]"/>
        <filter string="Needs fridge / cold chain" name="filter_cold" domain="[('cold_chain', '=', True)]"/>
        <filter string="From SFDA registry" name="filter_sfda" domain="[('sfda_reg_no', '!=', False)]"/>
        <separator/>
      </xpath>
    </field>
  </record>
</odoo>
